ONTOJEV_DATA_ROOT=.ontojev
ONTOJEV_RUN_TIMEOUT_SECONDS=600
ONTOJEV_FINALIZATION_RESERVE_SECONDS=30
ONTOJEV_DIRECTOR=deterministic
ONTOJEV_JEV=deterministic
ONTOCODEX_EXECUTABLE=codex
ONTOCODEX_MODEL=deepseek/deepseek-v4.1-flash
ONTOCODEX_TIMEOUT_SECONDS=120
# OPENROUTER_API_KEY is required only when ONTOJEV_DIRECTOR=codex.
TYPESAFE_MODEL=jev-latest
TYPESAFE_ENDPOINT=https://api.typesafe.ai/v1/systemone
TYPESAFE_TIMEOUT_SECONDS=30
# TYPESAFE_API_KEY is required only when ONTOJEV_JEV=typesafe.

